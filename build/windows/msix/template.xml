<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="nfa-tool-v3.exe"
        Arguments=""
        InstallLocation="C:\Program Files\My Company\NFA Tool Recode v2">
    </Installer>
    <PackageInformation
        PackageName="NFA Tool Recode v2"
        PackageDisplayName="NFA Tool Recode v2"
        PublisherName="CN=My Company"
        PublisherDisplayName="My Company"
        Version="1.0.0.0"
        PackageDescription="Steam Cache Login Tool">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.example.nfatoolv3"
                Description="Steam Cache Login Tool"
                DisplayName="NFA Tool Recode v2"
                ExecutableName="nfa-tool-v3.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>NFA Tool Recode v2</DisplayName>
            <PublisherDisplayName>My Company</PublisherDisplayName>
            <Description>Steam Cache Login Tool</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="nfa-tool-v3.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
